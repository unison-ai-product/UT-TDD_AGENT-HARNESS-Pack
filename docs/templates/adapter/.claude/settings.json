{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".ut-tdd/bin/ut-tdd.mjs","hook","agent-guard"],
            "timeout": 5,
            "blockOnFailure": true,
            "statusMessage": "agent-guard: subagent allowlist/model enforcement"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".ut-tdd/bin/ut-tdd.mjs","hook","work-guard"],
            "timeout": 5,
            "blockOnFailure": true,
            "statusMessage": "work-guard: foreign edit protection"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".ut-tdd/bin/ut-tdd.mjs","session","start"],
            "timeout": 5,
            "statusMessage": "session-log: session start (fail-open)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".ut-tdd/bin/ut-tdd.mjs","hook","post-tool-use"],
            "timeout": 5,
            "statusMessage": "session-log: post tool use (fail-open)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".ut-tdd/bin/ut-tdd.mjs","session","summary"],
            "timeout": 5,
            "statusMessage": "session-log: PLAN digest summary (fail-open)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".ut-tdd/bin/ut-tdd.mjs","hook","claude-memory-wake"],
            "timeout": 930,
            "asyncRewake": true,
            "statusMessage": "HARNESS memory: Claude宛て通知を待機"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".ut-tdd/bin/ut-tdd.mjs","hook","subagent-stop"],
            "timeout": 5,
            "statusMessage": "agent-slots: release oldest guard slot (fail-open)"
          }
        ]
      }
    ]
  }
}
