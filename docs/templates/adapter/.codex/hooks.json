{
  "description": "UT-TDD Codex adapter hooks (current command schema). Hosted/API tool surfaces still require explicit `ut-tdd guard preflight` before edits because repo-local Codex hooks do not execute there.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "spawn_agent|spawn_agents_on_csv",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ut-tdd/bin/ut-tdd.mjs\" hook agent-guard",
            "timeout": 5,
            "statusMessage": "agent-guard: Codex generic subagent type and model check"
          }
        ]
      },
      {
        "matcher": "apply_patch|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ut-tdd/bin/ut-tdd.mjs\" hook work-guard",
            "timeout": 5,
            "statusMessage": "work-guard: foreign edit protection"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ut-tdd/bin/ut-tdd.mjs\" session start",
            "timeout": 30,
            "statusMessage": "session-log: session start (fail-open)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|write_file|exec_command|local_shell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ut-tdd/bin/ut-tdd.mjs\" hook post-tool-use",
            "timeout": 30,
            "statusMessage": "session-log: post tool use (fail-open)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ut-tdd/bin/ut-tdd.mjs\" session summary",
            "timeout": 30,
            "statusMessage": "session-log: work digest summary (fail-open)"
          }
        ]
      }
    ]
  }
}
